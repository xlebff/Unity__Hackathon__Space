  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0440\u043E\u0442\u043E\u0437\u0432\u0435\u0437\u0434\u0430 \u2014
    \u0437\u0432\u0435\u0437\u0434\u0430 \u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u0430\u0434\u0438\u0438 \u0441\u0432\u043E\u0435\u0439 \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u0438
    \u0438 \u043D\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u044D\u0442\u0430\u043F\u0435 \u0441\u0432\u043E\u0435\u0433\u043E \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u043F\u0435\u0440\u0435\u0434 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435\u043C
    \u0442\u0435\u0440\u043C\u043E\u044F\u0434\u0435\u0440\u043D\u043E\u0433\u043E
    \u0441\u0438\u043D\u0442\u0435\u0437\u0430. \u0422\u043E\u0447\u043D\u044B\u0435
    \u0433\u0440\u0430\u043D\u0438\u0446\u044B \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u043D\u044F\u0442\u0438\u044F
    \u0440\u0430\u0437\u043C\u044B\u0442\u044B, \u0430 \u0441\u0430\u043C\u0438 \u043F\u0440\u043E\u0442\u043E\u0437\u0432\u0451\u0437\u0434\u044B
    \u043C\u043E\u0433\u0443\u0442 \u0438\u043C\u0435\u0442\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438."
