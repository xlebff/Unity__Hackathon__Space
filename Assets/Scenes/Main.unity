  m_text: "\u042F\u0434\u0435\u0440\u043D\u044B\u0435 \u0440\u0435\u0430\u043A\u0446\u0438\u0438
    \u0432 \u0437\u0432\u0451\u0437\u0434\u0430\u0445 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0438\u0445 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438. \u041E\u043D\u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442
    \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u044D\u043D\u0435\u0440\u0433\u043E\u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u043D\u0430 \u0435\u0434\u0438\u043D\u0438\u0446\u0443 \u043C\u0430\u0441\u0441\u044B,
    \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0437\u0432\u0451\u0437\u0434\u0430\u043C
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0432\u044B\u0441\u043E\u043A\u0443\u044E
    \u0441\u0432\u0435\u0442\u0438\u043C\u043E\u0441\u0442\u044C \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
    \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
